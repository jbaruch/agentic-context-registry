{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jbaruch/agentic-context-registry/schemas/agents.schema.json",
  "title": "ACR project dependencies",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^github:[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "declaration": {
      "type": "object",
      "required": ["source", "requested"],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "requested": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
