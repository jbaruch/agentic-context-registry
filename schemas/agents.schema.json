{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jbaruch/agentic-context-registry/schemas/agents.schema.json",
  "title": "ACR project dependencies",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "agents": {
      "type": "array",
      "items": {
        "enum": ["claude-code", "codex", "cursor"]
      },
      "uniqueItems": true
    },
    "freshness": {
      "enum": ["outdated", "install", "none"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "dependencies": {
            "items": {
              "not": {
                "required": ["hold"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^github:[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "requested": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^\\s|\\s$"}},
        {"not": {"pattern": "[~^:?*@]"}},
        {"not": {"pattern": "\\["}},
        {"not": {"pattern": "\\\\"}},
        {"not": {"pattern": "\\.\\."}},
        {"not": {"pattern": "^\\.|\\.$"}},
        {"not": {"pattern": "^/|/$"}}
      ]
    },
    "heldReference": {
      "allOf": [
        {"$ref": "#/$defs/requested"},
        {"not": {"const": "latest"}}
      ]
    },
    "hold": {
      "type": "object",
      "required": ["pin", "rejected"],
      "properties": {
        "pin": {
          "$ref": "#/$defs/heldReference"
        },
        "rejected": {
          "allOf": [
            {"$ref": "#/$defs/heldReference"},
            {"not": {"pattern": "^[0-9a-fA-F]{7,40}$"}}
          ]
        },
        "reason": {
          "type": "string",
          "allOf": [
            {"not": {"pattern": "^\\s|\\s$"}}
          ]
        }
      },
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "required": ["source", "requested"],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "requested": {
          "$ref": "#/$defs/requested"
        },
        "hold": {
          "$ref": "#/$defs/hold"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["hold"]
          },
          "then": {
            "properties": {
              "requested": {
                "const": "latest"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
