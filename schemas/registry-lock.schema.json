{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jbaruch/agentic-context-registry/schemas/registry-lock.schema.json",
  "title": "ACR immutable dependency lock",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lockedDependency"
      }
    },
    "realization": {
      "$ref": "#/$defs/realization"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["schemaVersion"],
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "dependencies": {
            "items": {
              "not": {
                "required": ["hold"]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^github:[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "requested": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^\\s|\\s$"}},
        {"not": {"pattern": "[~^:?*@]"}},
        {"not": {"pattern": "\\["}},
        {"not": {"pattern": "\\\\"}},
        {"not": {"pattern": "\\.\\."}},
        {"not": {"pattern": "^\\.|\\.$"}},
        {"not": {"pattern": "^/|/$"}}
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"pattern": "^/|/$"}},
        {"not": {"pattern": "\\\\"}},
        {"not": {"pattern": "[\\x00-\\x1f\\x7f]"}},
        {"not": {"pattern": "(?:^|/)\\.(?:/|$)"}},
        {"not": {"pattern": "(?:^|/)\\.\\.(?:/|$)"}},
        {"not": {"pattern": "//"}}
      ]
    },
    "realizationEntry": {
      "type": "object",
      "required": ["source", "artifactId", "artifactKind", "sourcePath", "adapter", "adapterVersion", "managedHash"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "artifactId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "artifactKind": {"enum": ["file", "managed-block", "structured-entry"]},
        "sourcePath": {"$ref": "#/$defs/relativePath"},
        "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "adapterVersion": {"type": "string", "minLength": 1},
        "managedHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "realizationTarget": {
      "type": "object",
      "required": ["path", "mode", "ownership", "outputHash", "entries"],
      "properties": {
        "path": {
          "allOf": [
            {"$ref": "#/$defs/relativePath"},
            {"not": {"enum": ["agents.yaml", ".agents", ".git"]}},
            {"not": {"pattern": "^\\.(?:agents|git)/"}}
          ]
        },
        "mode": {"type": "integer", "minimum": 1, "maximum": 511},
        "ownership": {"enum": ["generated-only", "shared"]},
        "outputHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "excluded": {"type": "boolean"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/realizationEntry"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"ownership": {"const": "shared"}}},
          "then": {"properties": {"excluded": {"const": false}}}
        }
      ],
      "additionalProperties": false
    },
    "realization": {
      "type": "object",
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": {"const": 1},
        "targets": {
          "type": "array",
          "items": {"$ref": "#/$defs/realizationTarget"}
        }
      },
      "additionalProperties": false
    },
    "lockedDependency": {
      "type": "object",
      "required": ["source", "requested", "kind", "commit", "packageVersion", "contentHash"],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "requested": {
          "$ref": "#/$defs/requested"
        },
        "kind": {
          "enum": ["release", "commit"]
        },
        "releaseId": {
          "type": "integer",
          "minimum": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "hold": {
          "$ref": "#/$defs/lockHold"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["hold"]
          },
          "then": {
            "properties": {
              "requested": {
                "const": "latest"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "release"
                  }
                }
              },
              {"not": {"required": ["hold"]}}
            ]
          },
          "then": {
            "required": ["releaseId", "tag"],
            "properties": {
              "requested": {
                "not": {
                  "pattern": "^[0-9a-fA-F]{7,40}$"
                }
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "release"
                  }
                }
              },
              {"required": ["hold"]}
            ]
          },
          "then": {
            "required": ["releaseId", "tag"]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "kind": {
                    "const": "commit"
                  }
                }
              },
              {"not": {"required": ["hold"]}}
            ]
          },
          "then": {
            "properties": {
              "requested": {
                "pattern": "^[0-9a-fA-F]{7,40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "commit"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["releaseId"]},
                {"required": ["tag"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "lockHold": {
      "type": "object",
      "required": ["rejectedTag"],
      "properties": {
        "rejectedTag": {
          "allOf": [
            {"$ref": "#/$defs/requested"},
            {"not": {"const": "latest"}},
            {"not": {"pattern": "^[0-9a-fA-F]{7,40}$"}}
          ]
        },
        "rejectedReleaseId": {
          "type": "integer",
          "minimum": 1
        },
        "rejectedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  }
}
