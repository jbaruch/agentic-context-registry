{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jbaruch/agentic-context-registry/schemas/acr-package.schema.json",
  "title": "ACR Package Release Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadataVersion",
    "name",
    "version",
    "schemaVersion",
    "tag",
    "commit",
    "repository",
    "contentHash",
    "files",
    "archive",
    "adapters",
    "generator"
  ],
  "properties": {
    "metadataVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "tag": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["0644", "0755"] },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "tarSha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^/]+\\.tar\\.gz$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tarSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "boundary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "boundary": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "generator": { "type": "string", "minLength": 1 }
  }
}
